<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug only: cleartext to 127.0.0.1 for the Mistral probe's loopback server. -->
    <application android:networkSecurityConfig="@xml/probe_network_security">

        <!-- adb shell am broadcast -n tech.dmconsulting.dixi/tech.dmconsulting.dixi.debug.MistralProbeReceiver
             DUMP: only the shell (adb) may send it, not other apps. -->
        <receiver
            android:name=".debug.MistralProbeReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Debug only. DUMP: only adb shell (or the system) can send it. -->
        <receiver
            android:name=".recording.DebugRecordingReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Auto-paste (DMC-141): off until the user turns it on in Android's accessibility settings.
             Debug only until Play accepts the accessibility declaration (v1.1, DMC-572):
             the release manifest declares no accessibility service. -->
        <service
            android:name=".paste.AutoPasteService"
            android:exported="true"
            android:label="@string/auto_paste_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_paste_service" />
        </service>
    </application>
</manifest>
