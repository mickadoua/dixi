    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">Aggiungi la tua chiave Mistral</string>
    <string name="key_guide_intro">Dixi usa la tua chiave Mistral per trasformare la tua voce in testo. Bastano circa due minuti.</string>
    <string name="key_guide_step1">1. Apri console.mistral.ai e accedi, oppure crea un account.</string>
    <string name="key_guide_step1_note">Mistral potrebbe prima chiederti di scegliere un piano e di confermare il tuo numero di telefono.</string>
    <string name="key_guide_step2">2. Nel menu, apri API Keys.</string>
    <string name="key_guide_step3">3. Tocca Create new key, dalle un nome (ad esempio «Dixi») e conferma.</string>
    <string name="key_guide_step4">4. Copia la chiave. Mistral la mostra una sola volta.</string>
    <string name="key_guide_step5">5. Torna su Dixi e incollala qui sotto.</string>
    <string name="key_guide_link">Apri la pagina API Keys di Mistral</string>
    <string name="key_check_valid_body">Mistral accetta questa chiave. Puoi continuare.</string>
    <string name="key_check_refused">Chiave rifiutata</string>
    <string name="key_cause_invalid">Mistral non riconosce questa chiave. Controlla di averla copiata tutta, senza spazi, oppure creane una nuova.</string>
    <string name="key_cause_no_access">Questa chiave non ha accesso all’API. Controlla che il tuo piano Mistral sia attivo.</string>
    <string name="key_cause_rate_limited">Mistral sta limitando questa chiave. Attendi un minuto e riprova.</string>
    <string name="key_cause_no_network">Nessuna connessione. Riprova quando sei online.</string>
    <string name="key_cause_unavailable">Mistral non risponde. Riprova tra qualche minuto.</string>
    <string name="key_continue">Continua</string>
    <string name="key_storage_note">La tua chiave resta cifrata su questo telefono. Dixi non la mostra mai e non ne fa mai il backup.</string>
    <string name="disclosure_intro">Per incollare il testo dettato nel campo in cui stai scrivendo, Dixi usa l’API del servizio di accessibilità di Android. Leggi cosa fa prima di attivarlo.</string>
    <string name="disclosure_reads_title">Cosa legge</string>
    <string name="disclosure_reads">Solo il campo in cui stai scrivendo, subito dopo una dettatura: se accetta testo, se è un campo password e a quale app appartiene. Non legge mai il testo del campo né il resto dello schermo.</string>
    <string name="disclosure_does_title">Cosa fa</string>
    <string name="disclosure_does">Incolla in quel campo il testo che hai appena dettato. Tra una dettatura e l’altra non fa nulla.</string>
    <string name="disclosure_does_not_title">Cosa non fa</string>
    <string name="disclosure_does_not">Non raccoglie dati, non salva nulla e non invia nulla: nessun dato lascia il telefono tramite questo servizio. Non incolla mai in un campo password.</string>
    <string name="disclosure_voice_note">La tua voce viene comunque inviata a Mistral per creare il testo, come senza incolla automatico.</string>
    <string name="disclosure_stop_title">Come disattivarlo</string>
    <string name="disclosure_stop">Disattiva Incolla automatico nelle impostazioni di Dixi in qualsiasi momento, oppure in Impostazioni Android › Accessibilità › Dixi · incolla automatico.</string>
    <string name="disclosure_next_step">Android aprirà le impostazioni di accessibilità. Scegli «Dixi · incolla automatico» e attivalo.</string>
