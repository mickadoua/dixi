    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">Add your Mistral key</string>
    <string name="key_guide_intro">Dixi uses your own Mistral key to turn your voice into text. It takes about two minutes.</string>
    <string name="key_guide_step1">1. Open console.mistral.ai and sign in, or create an account.</string>
    <string name="key_guide_step1_note">Mistral may first ask you to choose a plan and confirm your phone number.</string>
    <string name="key_guide_step2">2. In the menu, open API Keys.</string>
    <string name="key_guide_step3">3. Tap Create new key, name it (for example “Dixi”), then confirm.</string>
    <string name="key_guide_step4">4. Copy the key. Mistral shows it only once.</string>
    <string name="key_guide_step5">5. Come back to Dixi and paste it below.</string>
    <string name="key_guide_link">Open the Mistral API Keys page</string>
    <string name="key_check_valid_body">Mistral accepts this key. You can continue.</string>
    <string name="key_check_refused">Key refused</string>
    <string name="key_cause_invalid">Mistral does not recognise this key. Check that you copied all of it, with no spaces, or create a new one.</string>
    <string name="key_cause_no_access">This key has no access to the API. Check that your Mistral plan is active.</string>
    <string name="key_cause_rate_limited">Mistral is limiting this key for now. Wait a minute, then test again.</string>
    <string name="key_cause_no_network">No network. Test again once you are online.</string>
    <string name="key_cause_unavailable">Mistral is not responding. Test again in a few minutes.</string>
    <string name="key_continue">Continue</string>
    <string name="key_storage_note">Your key stays encrypted on this phone. Dixi never shows it and never backs it up.</string>
    <string name="disclosure_intro">To paste your dictated text into the field where you are typing, Dixi uses Android’s Accessibility Service API. Read what it does before you turn it on.</string>
    <string name="disclosure_reads_title">What it reads</string>
    <string name="disclosure_reads">Only the field you are typing in, right after a dictation: whether it accepts text, whether it is a password field, and which app it belongs to. It never reads the text in the field or anything else on your screen.</string>
    <string name="disclosure_does_title">What it does</string>
    <string name="disclosure_does">It pastes the text you just dictated into that field. It does nothing between dictations.</string>
    <string name="disclosure_does_not_title">What it does not do</string>
    <string name="disclosure_does_not">It collects no data, stores nothing and sends nothing: no data leaves your phone through this service. It never pastes into a password field.</string>
    <string name="disclosure_voice_note">Your voice is still sent to Mistral to make the text, as it is without auto-paste.</string>
    <string name="disclosure_stop_title">How to stop it</string>
    <string name="disclosure_stop">Turn off Auto-paste in Dixi’s settings at any time, or in Android Settings › Accessibility › Dixi · auto-paste.</string>
    <string name="disclosure_next_step">Android will open its accessibility settings. Choose “Dixi · auto-paste” and turn it on.</string>
    <string name="settings_auto_paste_on">On · pastes into the field you are typing in</string>
    <string name="settings_auto_paste_off">Off · the text is copied, you paste it</string>
