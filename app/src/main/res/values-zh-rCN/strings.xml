    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">添加你的 Mistral 密钥</string>
    <string name="key_guide_intro">Dixi 使用你自己的 Mistral 密钥将语音转为文字。大约需要两分钟。</string>
    <string name="key_guide_step1">1. 打开 console.mistral.ai 并登录，或创建账户。</string>
    <string name="key_guide_step1_note">Mistral 可能会先要求你选择套餐并验证手机号码。</string>
    <string name="key_guide_step2">2. 在菜单中打开 API Keys。</string>
    <string name="key_guide_step3">3. 点按 Create new key，为它命名（例如“Dixi”），然后确认。</string>
    <string name="key_guide_step4">4. 复制密钥。Mistral 只显示一次。</string>
    <string name="key_guide_step5">5. 回到 Dixi，在下方粘贴。</string>
    <string name="key_guide_link">打开 Mistral 的 API Keys 页面</string>
    <string name="key_check_valid_body">Mistral 接受此密钥。你可以继续。</string>
    <string name="key_check_refused">密钥被拒绝</string>
    <string name="key_cause_invalid">Mistral 无法识别此密钥。请确认已完整复制且没有空格，或创建一个新密钥。</string>
    <string name="key_cause_no_access">此密钥没有 API 访问权限。请确认你的 Mistral 套餐处于有效状态。</string>
    <string name="key_cause_rate_limited">Mistral 目前正在限制此密钥。请等待一分钟后再测试。</string>
    <string name="key_cause_no_network">没有网络。联网后再测试。</string>
    <string name="key_cause_unavailable">Mistral 没有响应。请几分钟后再测试。</string>
    <string name="key_continue">继续</string>
    <string name="key_storage_note">你的密钥加密保存在这部手机上。Dixi 从不显示它，也从不备份它。</string>
    <string name="disclosure_intro">为了把听写的文字粘贴到你正在输入的字段中，Dixi 使用 Android 的无障碍服务 API。开启前，请先了解它的作用。</string>
    <string name="disclosure_reads_title">它读取什么</string>
    <string name="disclosure_reads">仅在听写结束后，读取你正在输入的字段：它是否接受文字、是否为密码字段，以及属于哪个应用。它从不读取字段中的文字，也不读取屏幕上的其他内容。</string>
    <string name="disclosure_does_title">它做什么</string>
    <string name="disclosure_does">把你刚听写的文字粘贴到该字段中。两次听写之间它什么也不做。</string>
    <string name="disclosure_does_not_title">它不做什么</string>
    <string name="disclosure_does_not">它不收集任何数据，不存储任何内容，也不发送任何内容：没有任何数据通过此服务离开你的手机。它从不在密码字段中粘贴。</string>
    <string name="disclosure_voice_note">与不使用自动粘贴时一样，你的语音仍会发送给 Mistral 以生成文字。</string>
    <string name="disclosure_stop_title">如何关闭</string>
    <string name="disclosure_stop">随时可在 Dixi 的设置中关闭“自动粘贴”，或在 Android 设置 › 无障碍 › Dixi · 自动粘贴 中关闭。</string>
