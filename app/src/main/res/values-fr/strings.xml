    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">Ajoutez votre clé Mistral</string>
    <string name="key_guide_intro">Dixi utilise votre propre clé Mistral pour transformer votre voix en texte. Comptez deux minutes.</string>
    <string name="key_guide_step1">1. Ouvrez console.mistral.ai et connectez-vous, ou créez un compte.</string>
    <string name="key_guide_step1_note">Mistral peut d’abord vous demander de choisir une offre et de confirmer votre numéro de téléphone.</string>
    <string name="key_guide_step2">2. Dans le menu, ouvrez API Keys.</string>
    <string name="key_guide_step3">3. Touchez Create new key, nommez-la (par exemple « Dixi »), puis validez.</string>
    <string name="key_guide_step4">4. Copiez la clé. Mistral ne l’affiche qu’une fois.</string>
    <string name="key_guide_step5">5. Revenez dans Dixi et collez-la ci-dessous.</string>
    <string name="key_guide_link">Ouvrir la page API Keys de Mistral</string>
    <string name="key_check_valid_body">Mistral accepte cette clé. Vous pouvez continuer.</string>
    <string name="key_check_refused">Clé refusée</string>
    <string name="key_cause_invalid">Mistral ne reconnaît pas cette clé. Vérifiez que vous l’avez copiée en entier, sans espace, ou créez-en une nouvelle.</string>
    <string name="key_cause_no_access">Cette clé n’a pas accès à l’API. Vérifiez que votre offre Mistral est active.</string>
    <string name="key_cause_rate_limited">Mistral limite cette clé pour le moment. Attendez une minute, puis testez à nouveau.</string>
    <string name="key_cause_no_network">Pas de réseau. Testez à nouveau une fois connecté.</string>
    <string name="key_cause_unavailable">Mistral ne répond pas. Testez à nouveau dans quelques minutes.</string>
    <string name="key_continue">Continuer</string>
    <string name="key_storage_note">Votre clé reste chiffrée sur ce téléphone. Dixi ne l’affiche jamais et ne la sauvegarde jamais.</string>
    <string name="disclosure_intro">Pour coller le texte dicté dans le champ où vous écrivez, Dixi utilise l’API du service d’accessibilité d’Android. Lisez ce qu’il fait avant de l’activer.</string>
    <string name="disclosure_reads_title">Ce qu’il lit</string>
    <string name="disclosure_reads">Seulement le champ où vous écrivez, juste après une dictée : s’il accepte du texte, s’il s’agit d’un mot de passe, et à quelle app il appartient. Il ne lit jamais le texte du champ ni le reste de votre écran.</string>
    <string name="disclosure_does_title">Ce qu’il fait</string>
    <string name="disclosure_does">Il colle le texte que vous venez de dicter dans ce champ. Il ne fait rien entre deux dictées.</string>
    <string name="disclosure_does_not_title">Ce qu’il ne fait pas</string>
    <string name="disclosure_does_not">Il ne collecte aucune donnée, ne stocke rien et n’envoie rien : aucune donnée ne quitte votre téléphone par ce service. Il ne colle jamais dans un champ mot de passe.</string>
    <string name="disclosure_voice_note">Votre voix est toujours envoyée à Mistral pour produire le texte, comme sans collage automatique.</string>
    <string name="disclosure_stop_title">Comment l’arrêter</string>
    <string name="disclosure_stop">Désactivez Collage automatique dans les réglages de Dixi à tout moment, ou dans Paramètres Android › Accessibilité › Dixi · collage automatique.</string>
    <string name="disclosure_next_step">Android va ouvrir ses réglages d’accessibilité. Choisissez « Dixi · collage automatique » et activez-le.</string>
