<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The user's Mistral keys (no_backup/mistral_keys/, DMC-227, DMC-766) never leave
     the phone: neither in the cloud backup nor in a transfer to a new device. Nor does the
     history of dictations (DMC-338). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
        <exclude domain="file" path="datastore/dictation_history.json" />
    </device-transfer>
</data-extraction-rules>
