<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The user's Mistral key (no_backup/mistral_key.bin, DMC-227) never leaves
     the phone: neither in the cloud backup nor in a transfer to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="no_backup/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="no_backup/" />
    </device-transfer>
</data-extraction-rules>
