    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">Añade tu clave de Mistral</string>
    <string name="key_guide_intro">Dixi usa tu propia clave de Mistral para convertir tu voz en texto. Son unos dos minutos.</string>
    <string name="key_guide_step1">1. Abre console.mistral.ai e inicia sesión, o crea una cuenta.</string>
    <string name="key_guide_step1_note">Puede que Mistral te pida antes elegir un plan y confirmar tu número de teléfono.</string>
    <string name="key_guide_step2">2. En el menú, abre API Keys.</string>
    <string name="key_guide_step3">3. Toca Create new key, ponle un nombre (por ejemplo «Dixi») y confirma.</string>
    <string name="key_guide_step4">4. Copia la clave. Mistral solo la muestra una vez.</string>
    <string name="key_guide_step5">5. Vuelve a Dixi y pégala abajo.</string>
    <string name="key_guide_link">Abrir la página API Keys de Mistral</string>
    <string name="key_check_valid_body">Mistral acepta esta clave. Puedes continuar.</string>
    <string name="key_check_refused">Clave rechazada</string>
    <string name="key_cause_invalid">Mistral no reconoce esta clave. Comprueba que la has copiado entera, sin espacios, o crea una nueva.</string>
    <string name="key_cause_no_access">Esta clave no tiene acceso a la API. Comprueba que tu plan de Mistral está activo.</string>
    <string name="key_cause_rate_limited">Mistral está limitando esta clave por ahora. Espera un minuto y vuelve a probar.</string>
    <string name="key_cause_no_network">Sin conexión. Vuelve a probar cuando tengas red.</string>
    <string name="key_cause_unavailable">Mistral no responde. Vuelve a probar en unos minutos.</string>
    <string name="key_continue">Continuar</string>
    <string name="key_storage_note">Tu clave se guarda cifrada en este teléfono. Dixi nunca la muestra ni hace copia de seguridad de ella.</string>
    <string name="disclosure_intro">Para pegar el texto dictado en el campo donde escribes, Dixi usa la API del servicio de accesibilidad de Android. Lee lo que hace antes de activarlo.</string>
    <string name="disclosure_reads_title">Qué lee</string>
    <string name="disclosure_reads">Solo el campo donde escribes, justo después de dictar: si acepta texto, si es un campo de contraseña y a qué app pertenece. Nunca lee el texto del campo ni nada más de tu pantalla.</string>
    <string name="disclosure_does_title">Qué hace</string>
    <string name="disclosure_does">Pega en ese campo el texto que acabas de dictar. No hace nada entre dos dictados.</string>
    <string name="disclosure_does_not_title">Qué no hace</string>
    <string name="disclosure_does_not">No recoge ningún dato, no guarda nada y no envía nada: ningún dato sale de tu teléfono a través de este servicio. Nunca pega en un campo de contraseña.</string>
    <string name="disclosure_voice_note">Tu voz se sigue enviando a Mistral para crear el texto, igual que sin pegado automático.</string>
    <string name="disclosure_stop_title">Cómo desactivarlo</string>
    <string name="disclosure_stop">Desactiva Pegado automático en los ajustes de Dixi cuando quieras, o en Ajustes de Android › Accesibilidad › Dixi · pegado automático.</string>
    <string name="disclosure_next_step">Android abrirá sus ajustes de accesibilidad. Elige «Dixi · pegado automático» y actívalo.</string>
