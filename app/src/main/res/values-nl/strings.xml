    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">Voeg je Mistral-sleutel toe</string>
    <string name="key_guide_intro">Dixi gebruikt je eigen Mistral-sleutel om je stem in tekst om te zetten. Het duurt ongeveer twee minuten.</string>
    <string name="key_guide_step1">1. Open console.mistral.ai en log in, of maak een account aan.</string>
    <string name="key_guide_step1_note">Mistral kan je eerst vragen een abonnement te kiezen en je telefoonnummer te bevestigen.</string>
    <string name="key_guide_step2">2. Open in het menu API Keys.</string>
    <string name="key_guide_step3">3. Tik op Create new key, geef hem een naam (bijvoorbeeld ‘Dixi’) en bevestig.</string>
    <string name="key_guide_step4">4. Kopieer de sleutel. Mistral toont hem maar één keer.</string>
    <string name="key_guide_step5">5. Ga terug naar Dixi en plak hem hieronder.</string>
    <string name="key_guide_link">Open de pagina API Keys van Mistral</string>
    <string name="key_check_valid_body">Mistral accepteert deze sleutel. Je kunt verder.</string>
    <string name="key_check_refused">Sleutel geweigerd</string>
    <string name="key_cause_invalid">Mistral herkent deze sleutel niet. Controleer of je hem helemaal hebt gekopieerd, zonder spaties, of maak een nieuwe.</string>
    <string name="key_cause_no_access">Deze sleutel heeft geen toegang tot de API. Controleer of je Mistral-abonnement actief is.</string>
    <string name="key_cause_rate_limited">Mistral beperkt deze sleutel op dit moment. Wacht een minuut en test opnieuw.</string>
    <string name="key_cause_no_network">Geen netwerk. Test opnieuw zodra je online bent.</string>
    <string name="key_cause_unavailable">Mistral reageert niet. Test over een paar minuten opnieuw.</string>
    <string name="key_continue">Doorgaan</string>
    <string name="key_storage_note">Je sleutel blijft versleuteld op deze telefoon. Dixi toont hem nooit en maakt er nooit een back-up van.</string>
    <string name="disclosure_intro">Om je gedicteerde tekst in het veld te plakken waarin je typt, gebruikt Dixi de toegankelijkheidsservice-API van Android. Lees wat die doet voordat je hem aanzet.</string>
    <string name="disclosure_reads_title">Wat hij leest</string>
    <string name="disclosure_reads">Alleen het veld waarin je typt, direct na een dictaat: of het tekst accepteert, of het een wachtwoordveld is en bij welke app het hoort. Hij leest nooit de tekst in het veld of iets anders op je scherm.</string>
    <string name="disclosure_does_title">Wat hij doet</string>
    <string name="disclosure_does">Hij plakt de tekst die je net hebt gedicteerd in dat veld. Tussen twee dictaten doet hij niets.</string>
    <string name="disclosure_does_not_title">Wat hij niet doet</string>
    <string name="disclosure_does_not">Hij verzamelt geen gegevens, slaat niets op en verstuurt niets: via deze service verlaten geen gegevens je telefoon. Hij plakt nooit in een wachtwoordveld.</string>
    <string name="disclosure_voice_note">Je stem wordt nog steeds naar Mistral gestuurd om de tekst te maken, net als zonder automatisch plakken.</string>
    <string name="disclosure_stop_title">Zo zet je hem uit</string>
    <string name="disclosure_stop">Zet Automatisch plakken op elk moment uit in de instellingen van Dixi, of in Android-instellingen › Toegankelijkheid › Dixi · automatisch plakken.</string>
    <string name="disclosure_next_step">Android opent de toegankelijkheidsinstellingen. Kies ‘Dixi · automatisch plakken’ en zet het aan.</string>
