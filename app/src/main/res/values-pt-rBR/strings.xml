    <!-- Mockups DMC-764 and texts DMC-765 (DMC-768): bubble, guided trial, home, Mistral key, auto-paste disclosure. -->
    <string name="key_guide_title">Adicione sua chave Mistral</string>
    <string name="key_guide_intro">O Dixi usa sua própria chave Mistral para transformar sua voz em texto. Leva uns dois minutos.</string>
    <string name="key_guide_step1">1. Abra console.mistral.ai e entre, ou crie uma conta.</string>
    <string name="key_guide_step1_note">A Mistral pode pedir antes que você escolha um plano e confirme seu número de telefone.</string>
    <string name="key_guide_step2">2. No menu, abra API Keys.</string>
    <string name="key_guide_step3">3. Toque em Create new key, dê um nome (por exemplo “Dixi”) e confirme.</string>
    <string name="key_guide_step4">4. Copie a chave. A Mistral mostra a chave só uma vez.</string>
    <string name="key_guide_step5">5. Volte ao Dixi e cole abaixo.</string>
    <string name="key_guide_link">Abrir a página API Keys da Mistral</string>
    <string name="key_check_valid_body">A Mistral aceita esta chave. Você pode continuar.</string>
    <string name="key_check_refused">Chave recusada</string>
    <string name="key_cause_invalid">A Mistral não reconhece esta chave. Confira se você copiou a chave inteira, sem espaços, ou crie uma nova.</string>
    <string name="key_cause_no_access">Esta chave não tem acesso à API. Confira se o seu plano Mistral está ativo.</string>
    <string name="key_cause_rate_limited">A Mistral está limitando esta chave no momento. Espere um minuto e teste de novo.</string>
    <string name="key_cause_no_network">Sem conexão. Teste de novo quando estiver on-line.</string>
    <string name="key_cause_unavailable">A Mistral não está respondendo. Teste de novo em alguns minutos.</string>
    <string name="key_continue">Continuar</string>
    <string name="key_storage_note">Sua chave fica criptografada neste celular. O Dixi nunca mostra a chave e nunca faz backup dela.</string>
    <string name="disclosure_intro">Para colar o texto ditado no campo em que você está digitando, o Dixi usa a API do serviço de acessibilidade do Android. Leia o que ele faz antes de ativar.</string>
    <string name="disclosure_reads_title">O que ele lê</string>
    <string name="disclosure_reads">Só o campo em que você está digitando, logo depois de um ditado: se ele aceita texto, se é um campo de senha e a qual app pertence. Ele nunca lê o texto do campo nem nada mais da sua tela.</string>
    <string name="disclosure_does_title">O que ele faz</string>
    <string name="disclosure_does">Ele cola nesse campo o texto que você acabou de ditar. Não faz nada entre um ditado e outro.</string>
    <string name="disclosure_does_not_title">O que ele não faz</string>
    <string name="disclosure_does_not">Ele não coleta nenhum dado, não guarda nada e não envia nada: nenhum dado sai do seu celular por este serviço. Ele nunca cola em um campo de senha.</string>
    <string name="disclosure_voice_note">Sua voz continua sendo enviada à Mistral para gerar o texto, como sem a colagem automática.</string>
    <string name="disclosure_stop_title">Como desativar</string>
    <string name="disclosure_stop">Desative Colar automaticamente nas configurações do Dixi a qualquer momento, ou em Configurações do Android › Acessibilidade › Dixi · colar automaticamente.</string>
    <string name="disclosure_next_step">O Android vai abrir as configurações de acessibilidade. Escolha “Dixi · colar automaticamente” e ative.</string>
